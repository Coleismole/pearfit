# Base URL of the Pearfit API. This is the app's only setting, and it is not a secret.
# When it is unset the app uses https://www.pearfit.app (the default lives in src/config.ts).
# To point the app at another deployment, copy this file to .env.local (gitignored) and change the value.
VITE_API_BASE_URL=https://www.pearfit.app
