# Copy to .env.local (gitignored) to run: node cli/export-candidates.ts --source supabase
# Same shared Supabase project as webscraper/.env.example.
SUPABASE_URL=
# Publishable (anon) key. It can read the export tables once webscraper/fit_store.sql has been run.
SUPABASE_PUBLISHABLE_KEY=
# Optional. Bypasses RLS for reads. Never commit it.
SUPABASE_SECRET_KEY=
