{
  "name": "fit-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pilot 1 size matching scorer. Pure TypeScript, runs on Node 22.18+ with no build step.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "recommend": "node cli/recommend.ts",
    "eval": "node cli/eval.ts",
    "eval:generated": "node cli/eval.ts --candidates data/candidates.generated.json",
    "export-candidates": "node cli/export-candidates.ts",
    "export-fit-catalog": "node cli/export-fit-catalog.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:api": "node scripts/build-api.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@sentry/node": "^11.12.0"
  }
}
