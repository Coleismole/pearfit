{
  "installCommand": "npm install --prefix webscraper && npm install",
  "buildCommand": "node scripts/assemble-site.mjs",
  "outputDirectory": "site",
  "rewrites": [
    { "source": "/scraper/api/(.*)", "destination": "/api/scraper/$1" },
    { "source": "/scraper", "destination": "/scraper/index.html" },
    { "source": "/scraper/(.*)", "destination": "/scraper/index.html" }
  ],
  "functions": {
    "api/scraper/[[...path]].js": {
      "maxDuration": 60,
      "includeFiles": "api/scraper/.env.example"
    }
  }
}
