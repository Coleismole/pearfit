# Shared Supabase project. The publishable key is safe to commit; it is the anon role.
# A local SUPABASE_SECRET_KEY in .env.local overrides it. Review text stays in SQLite.
# Run fit_store.sql once so this key may call commit_fit_report and list_fit_catalog.
SUPABASE_URL=https://beidotlssxvfmvgiiypd.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_lEuoTCaujbySyV5Gf_AZoA_U_1uMg6Z
SUPABASE_SECRET_KEY=

# PostHog analytics for the scraper page. Both are public browser settings, not secrets.
# Leave empty to turn analytics off. On pearfit.app the website project already sets them.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# Sentry error reporting. The DSN is a public ingest key, not a secret; the default (the pearfit-api project) is in the code.
# Set it to another project's DSN to send events there, or to an empty string to turn Sentry off.
# SENTRY_DSN=
