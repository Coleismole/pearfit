# Public PostHog browser configuration
POSTHOG_PROJECT_TOKEN=phc_your_project_token
POSTHOG_HOST=https://your-posthog-host

# Read by website/api/recommend.js and candidates.js (built from engine/api). Set both in the Vercel project.
# The publishable key is the anon role and can only read the three export tables. The API never uses
# SUPABASE_SECRET_KEY, even if the project has one.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
