{
  "installCommand": "npm ci",
  "buildCommand": "echo Pearfit site",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/scraper/api/(.*)", "destination": "/api/scraper/$1" },
    { "source": "/scraper", "destination": "/scraper/index.html" },
    { "source": "/scraper/(.*)", "destination": "/scraper/index.html" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/((?!.*\\.[A-Za-z0-9]+$).*)", "destination": "/app/index.html" }
  ],
  "functions": {
    "api/scraper/[[...path]].js": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "api/scraper/.env.example"
    }
  }
}
